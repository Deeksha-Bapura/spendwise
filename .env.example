# ── Database ──────────────────────────────────────────────
# Local (docker compose). In production use your Neon pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/spendwise"
# Integration tests wipe this database. Must contain "test" in its name.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/spendwise_test"

# ── Auth (Better Auth) ───────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Optional GitHub OAuth. New GitHub users join DEFAULT_ORG_SLUG as employees.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DEFAULT_ORG_SLUG="acme"

# Brute-force protection on sign-in. Keep "true" except for e2e runs.
AUTH_RATE_LIMIT="true"

# ── Plaid (https://dashboard.plaid.com/developers/keys) ──
# Leave blank to run without Plaid: demo data still works, "Connect a bank" is disabled.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Public URL for Plaid webhooks, e.g. a tunnel to localhost:
#   https://<random>.trycloudflare.com/api/webhooks/plaid
# Leave blank to skip webhooks and use the "Sync now" button instead.
PLAID_WEBHOOK_URL=""

# Encrypts Plaid access tokens at rest. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing bank connections unreadable (reconnect them).
TOKEN_ENCRYPTION_KEY="replace-with-32-random-bytes-base64"

# Protects the webhook retry endpoint (/api/cron/webhooks). At least 16 characters.
CRON_SECRET="replace-with-a-long-random-string"

# ── App ───────────────────────────────────────────────────
# Shows the "Sign in as ..." demo buttons on /login.
DEMO_MODE="true"
LOG_LEVEL="info"
