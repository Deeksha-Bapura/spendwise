# ── Database ──────────────────────────────────────────────
# Local (docker compose). In production use your Neon pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/spendwise"
# Integration tests wipe this database. Must contain "test" in its name.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/spendwise_test"

# ── Auth (Better Auth) ───────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Optional GitHub OAuth. New GitHub users join DEFAULT_ORG_SLUG as employees.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DEFAULT_ORG_SLUG="acme"

# Brute-force protection on sign-in. Keep "true" except for e2e runs.
AUTH_RATE_LIMIT="true"

# ── App ───────────────────────────────────────────────────
# Shows the "Sign in as ..." demo buttons on /login.
DEMO_MODE="true"
LOG_LEVEL="info"
